# =====================================================================
# AI Study Assistant Agent - Environment Configuration
# =====================================================================
# Duplicate this file, rename it to '.env', and paste your API key below.
# DO NOT commit your real '.env' file to Git or version control!

# Option 1: Google Gemini API (Recommended for students - free key at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Option 2: OpenAI API (Optional - if you prefer OpenAI models like gpt-4o-mini)
OPENAI_API_KEY=your_openai_api_key_here
